@model IEnumerable<Sala>
@{
    ViewData["Title"] = "Salas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Salas</h1>
        <p class="text-muted">Consulta y administra las salas del cine.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar sala</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Capacidad</th>
            <th>Formato</th>
            <th>Activa</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.NombreSala</td>
            <td>@item.Capacidad personas</td>
            <td>@item.FormatoSala</td>
            <td>@(item.Activa ? "Sí" : "No")</td>
            <td class="table-actions">
                <a asp-action="Edit" asp-route-id="@item.IdSala">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdSala">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.IdSala">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay salas registradas.</p>
}