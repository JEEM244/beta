@model IEnumerable<Sala>
@{
    ViewData["Title"] = "Salas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <span class="eyebrow">ESPACIOS DEL CINE</span>
        <h1 class="page-title">Salas</h1>
        <p class="page-subtitle mb-0">Consulta y administra las salas registradas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar sala</a>
</div>

<div class="table-shell">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Capacidad</th>
                <th>Formato</th>
                <th>Activa</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.NombreSala</td>
                <td>@item.Capacidad personas</td>
                <td><span class="data-tag">@item.FormatoSala</span></td>
                <td>
                    <span class="status-pill @(item.Activa ? "status-on" : "status-off")">
                        @(item.Activa ? "Sí" : "No")
                    </span>
                </td>
                <td class="table-actions">
                    <a asp-action="Edit" asp-route-id="@item.IdSala">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdSala">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdSala">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-muted m-3">Todavía no hay salas registradas.</p>
    }
</div>