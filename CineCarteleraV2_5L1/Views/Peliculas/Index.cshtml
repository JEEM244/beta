@model IEnumerable<Pelicula>
@{
    ViewData["Title"] = "Películas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Películas</h1>
        <p class="text-muted">Consulta y administra las películas registradas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar película</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Genero)</th>
            <th>Duración</th>
            <th>@Html.DisplayNameFor(model => model.Clasificacion)</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Titulo</td>
            <td>@item.Genero</td>
            <td>@item.DuracionMinutos min</td>
            <td>@item.Clasificacion</td>
            <td>@(item.Disponible ? "Sí" : "No")</td>
            <td class="table-actions">
                <a asp-action="Edit" asp-route-id="@item.IdPelicula">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdPelicula">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.IdPelicula">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay películas registradas.</p>
}