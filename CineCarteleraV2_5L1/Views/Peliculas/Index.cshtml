@model IEnumerable<Pelicula>
@{
    ViewData["Title"] = "Películas";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <span class="eyebrow">ADMINISTRACIÓN DEL CATÁLOGO</span>
        <h1 class="page-title">Películas</h1>
        <p class="page-subtitle mb-0">Gestiona los títulos disponibles en la cartelera.</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">+ Registrar película</a>
</div>

<div class="table-shell">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Duración</th>
                <th>Clasificación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Titulo</td>
                <td>@item.Genero</td>
                <td>@item.DuracionMinutos min</td>
                <td><span class="data-tag">@item.Clasificacion</span></td>
                <td>
                    <span class="status-pill @(item.Disponible ? "status-on" : "status-off")">
                        @(item.Disponible ? "Disponible" : "No disponible")
                    </span>
                </td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-id="@item.IdPelicula">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdPelicula">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdPelicula">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state m-3">
            <h3>No hay películas registradas</h3>
            <p>Agrega el primer título para comenzar tu catálogo.</p>
            <a asp-action="Create" class="btn btn-accent">Registrar película</a>
        </div>
    }
</div>