@model IEnumerable<Pelicula>
@{
    ViewData["Title"] = "Películas";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <span class="eyebrow">CATÁLOGO</span>
        <h1 class="page-title">Películas</h1>
        <p class="page-subtitle mb-0">Consulta y administra las películas registradas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar película</a>
</div>

<div class="table-shell">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Duración</th>
                <th>Clasificación</th>
                <th>Disponible</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Titulo</td>
                <td>@item.Genero</td>
                <td>@item.DuracionMinutos min</td>
                <td><span class="data-tag">@item.Clasificacion</span></td>
                <td>
                    <span class="status-pill @(item.Disponible ? "status-on" : "status-off")">
                        @(item.Disponible ? "Sí" : "No")
                    </span>
                </td>
                <td class="table-actions">
                    <a asp-action="Edit" asp-route-id="@item.IdPelicula">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdPelicula">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdPelicula">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-muted m-3">Todavía no hay películas registradas.</p>
    }
</div>