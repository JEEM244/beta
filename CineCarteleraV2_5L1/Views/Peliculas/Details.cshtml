@model Pelicula
@{
    ViewData["Title"] = "Detalles de película";
}

<h1 class="page-title">Detalles de película</h1>
<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@Model.Genero</dd>
    <dt class="col-sm-3">Duración</dt>
    <dd class="col-sm-9">@Model.DuracionMinutos minutos</dd>
    <dt class="col-sm-3">Clasificación</dt>
    <dd class="col-sm-9">@Model.Clasificacion</dd>
    <dt class="col-sm-3">Fecha de estreno</dt>
    <dd class="col-sm-9">@(Model.FechaEstreno?.ToString("dd/MM/yyyy") ?? "Sin fecha")</dd>
    <dt class="col-sm-3">Sinopsis</dt>
    <dd class="col-sm-9">@(Model.Sinopsis ?? "Sin sinopsis")</dd>
    <dt class="col-sm-3">Disponible</dt>
    <dd class="col-sm-9">@(Model.Disponible ? "Sí" : "No")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdPelicula" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar</a>