@model Pelicula
@{
    ViewData["Title"] = "Eliminar película";
}

<h1 class="page-title">Eliminar película</h1>
<p>¿Estás seguro de que deseas eliminar esta película?</p>
<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@Model.Genero</dd>
    <dt class="col-sm-3">Duración</dt>
    <dd class="col-sm-9">@Model.DuracionMinutos minutos</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdPelicula" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>