@model Salas5L1
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="NombreSala" class="form-label"></label><input asp-for="NombreSala" class="form-control" /><span asp-validation-for="NombreSala" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Capacidad" class="form-label"></label><input asp-for="Capacidad" class="form-control" /><span asp-validation-for="Capacidad" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="TipoSala" class="form-label"></label><select asp-for="TipoSala" class="form-select"><option value="">Selecciona...</option><option>Tradicional</option><option>3D</option><option>VIP</option><option>IMAX</option></select><span asp-validation-for="TipoSala" class="text-danger"></span></div></div>
<div class="form-check mb-3"><input asp-for="Activa" class="form-check-input" /><label asp-for="Activa" class="form-check-label">Sala activa</label></div>