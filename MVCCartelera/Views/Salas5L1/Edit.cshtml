@model Salas5L1
@{ ViewData["Title"] = "Editar sala"; }
<div class="page-heading"><div><p class="eyebrow">ESPACIOS / EDICIÓN</p><h1>Editar sala</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.IdSala" class="form-panel"><input type="hidden" asp-for="IdSala" /><partial name="FormSala" model="Model" /><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancelar</a><button type="submit" class="btn btn-cinema">Guardar cambios</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }