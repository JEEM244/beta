@model Movies5L1
@{ ViewData["Title"] = "Editar película"; }
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO / EDICIÓN</p><h1>Editar película</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.IdMovie" class="form-panel">
    <input type="hidden" asp-for="IdMovie" />
    <partial name="_Form" model="Model" />
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancelar</a><button class="btn btn-cinema" type="submit">Guardar cambios</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }