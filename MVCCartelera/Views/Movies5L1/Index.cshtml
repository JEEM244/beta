@model IEnumerable<Movies5L1>
@{
    ViewData["Title"] = "Películas";
}
<div class="page-heading">
    <div><p class="eyebrow">CATÁLOGO / 01</p><h1>Películas</h1><p>Listado de películas registradas en la cartelera.</p></div>
    <a asp-action="Create" class="btn btn-cinema">Agregar película</a>
</div>
<div class="table-wrap">
<table class="table cinema-table align-middle">
    <thead><tr><th>Título</th><th>Género</th><th>Duración</th><th>Clasificación</th><th>Sala</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td class="fw-semibold">@item.Titulo</td><td>@item.Genero</td><td>@item.DuracionMinutos min</td><td><span class="rating-tag">@item.Clasificacion</span></td><td>@item.Sala?.NombreSala</td>
            <td class="text-end action-links"><a asp-action="Details" asp-route-id="@item.IdMovie">Ver</a><a asp-action="Edit" asp-route-id="@item.IdMovie">Editar</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.IdMovie">Eliminar</a></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="empty-state">Todavía no hay películas registradas.</p> }
</div>