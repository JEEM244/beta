<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cartelera 5L1</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark cinema-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">CARTELERA <span>5L1</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Movies5L1" asp-action="Index">Películas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Salas5L1" asp-action="Index">Salas</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="container py-4">
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }
    @RenderBody()
</main>
<footer class="container footer-note">Práctica MVC · SQL Server · Grupo 5L1</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>